# VidyaSetu Environment Configuration

# Application Profiles
SPRING_PROFILES_ACTIVE=local-embedded
APP_DEMO_MODE=true
APP_SEED_ON_STARTUP=true

# Database Configuration (for external postgres)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vidyasetu
SPRING_DATASOURCE_USERNAME=vidyasetu
SPRING_DATASOURCE_PASSWORD=vidyasetu_dev_password

# Security & Crypto Secrets
APP_CRYPTO_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
APP_JWT_ISSUER=vidyasetu.aicte.gov.in
APP_JWT_AUDIENCE=vidyasetu-platform
APP_JWT_ACCESS_MINUTES=15

# Integration Mocks
APAAR_PROVIDER=mock
APAAR_MOCK_CHAOS=false
APAAR_MOCK_LATENCY_MS=0
