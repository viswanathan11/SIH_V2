{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://REPLACE_WITH_YOUR_RENDER_URL.onrender.com/api/$1"
    },
    {
      "source": "/.well-known/(.*)",
      "destination": "https://REPLACE_WITH_YOUR_RENDER_URL.onrender.com/.well-known/$1"
    },
    {
      "source": "/swagger-ui/(.*)",
      "destination": "https://REPLACE_WITH_YOUR_RENDER_URL.onrender.com/swagger-ui/$1"
    },
    {
      "source": "/v3/(.*)",
      "destination": "https://REPLACE_WITH_YOUR_RENDER_URL.onrender.com/v3/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
